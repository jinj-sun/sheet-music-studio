{
  "name": "puxie-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-omr.mjs && vite --host 127.0.0.1",
    "dev:client": "npm run dev",
    "build": "node scripts/prepare-omr.mjs && npm run type:check && vite build",
    "build:client": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "npm run preview",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "models:check": "node scripts/check-models.mjs",
    "omr:assets": "node scripts/copy-omr-assets.mjs",
    "models:download": "node scripts/download-models.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "homr-web": "0.5.4",
    "lucide-react": "0.577.0",
    "opensheetmusicdisplay": "2.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "npm": ">=10"
  }
}
